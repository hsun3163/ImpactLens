# No model services or model API keys are used.
NEXT_TELEMETRY_DISABLED=1

# SMS module. Configure runtime values through Sites secrets, never this file.
# Leave unconfigured until an authorized provider account/number is available.
# All live dashboards and maintenance require explicitly allowlisted Sites IDs.
TPW_ADMIN_USER_IDS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=
# Set to https://YOUR_HOST/api/sms/inbound (exact public URL, no query).

# Optional external MCP event callback allowlist; leave unset for polling/manual pickup.
MCP_EVENTS_CALLBACK_ORIGIN=
