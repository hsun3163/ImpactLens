      "checkConstraints": {
        "course_summary_revision": {
          "name": "course_summary_revision",
          "value": "\"course_summaries\".\"revision\" >= 1 AND \"course_summaries\".\"revision\" <= 9007199254740991"
        },
        "course_summary_status": {
          "name": "course_summary_status",
          "value": "\"course_summaries\".\"status\" IN ('planned', 'in-progress', 'completed')"
        },
        "course_summary_participants": {
          "name": "course_summary_participants",
          "value": "\"course_summaries\".\"participants\" IS NULL OR (typeof(\"course_summaries\".\"participants\") = 'integer' AND \"course_summaries\".\"participants\" BETWEEN 0 AND 1000000)"
        },
        "course_summary_completers": {
          "name": "course_summary_completers",
          "value": "\"course_summaries\".\"completers\" IS NULL OR (typeof(\"course_summaries\".\"completers\") = 'integer' AND \"course_summaries\".\"completers\" BETWEEN 0 AND 1000000)"
        },
        "course_summary_completion_bound": {
          "name": "course_summary_completion_bound",
          "value": "\"course_summaries\".\"participants\" IS NULL OR \"course_summaries\".\"completers\" IS NULL OR \"course_summaries\".\"completers\" <= \"course_summaries\".\"participants\""
        },
        "course_summary_hours": {
          "name": "course_summary_hours",
          "value": "\"course_summaries\".\"course_hours_per_participant\" IS NULL OR \"course_summaries\".\"course_hours_per_participant\" BETWEEN 0 AND 1000000"
        },
        "course_summary_date_order": {
          "name": "course_summary_date_order",
          "value": "\"course_summaries\".\"start_date\" IS NULL OR \"course_summaries\".\"end_date\" IS NULL OR \"course_summaries\".\"end_date\" >= \"course_summaries\".\"start_date\""
        }
      }
